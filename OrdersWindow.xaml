<Window x:Class="SamokatAppClean.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Name="txtSearch" Width="300"/>
            <Button Content="Найти" Margin="5,0" Click="btnSearch_Click"/>
            <Button Content="На главную" Margin="20,0,0,0" Click="btnBack_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="Добавить" Width="100" Margin="5" Click="btnAdd_Click"/>
            <Button Content="Изменить" Width="100" Margin="5" Click="btnEdit_Click"/>
            <Button Content="Удалить" Width="100" Margin="5" Click="btnDelete_Click"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Name="txtStatus" Foreground="Red" Margin="5" Height="25"/>

        <DataGrid Name="dgOrders" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="dgOrders_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding id}" Header="№" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding order_date}" Header="Дата" Width="*"/>
                <DataGridTextColumn Binding="{Binding clients.full_name}" Header="Клиент" Width="*"/>
                <DataGridTextColumn Binding="{Binding couriers.full_name}" Header="Курьер" Width="*"/>
                <DataGridTextColumn Binding="{Binding delivery_address}" Header="Адрес доставки" Width="2*"/>
                <DataGridTextColumn Binding="{Binding status}" Header="Статус" Width="*"/>
                <DataGridTextColumn Binding="{Binding total_weight_kg}" Header="Вес (кг)" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>