<Window x:Class="SamokatAppClean.CouriersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Курьеры" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Name="txtSearch" Width="300"/>
            <Button Content="Найти" Margin="5,0" Click="btnSearch_Click"/>
            <Button Content="На главную" Margin="20,0,0,0" Click="btnBack_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="Добавить" Width="100" Margin="5" Click="btnAdd_Click"/>
            <Button Content="Изменить" Width="100" Margin="5" Click="btnEdit_Click"/>
            <Button Content="Удалить" Width="100" Margin="5" Click="btnDelete_Click"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Name="txtStatus" Foreground="Red" Margin="5" Height="25"/>

        <DataGrid Name="dgCouriers" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="dgCouriers_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding full_name}" Header="ФИО" Width="2*"/>
                <DataGridTextColumn Binding="{Binding phone}" Header="Телефон" Width="2*"/>
                <DataGridTextColumn Binding="{Binding transport.transport_name}" Header="Транспорт" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>