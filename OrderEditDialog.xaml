<Window x:Class="SamokatAppClean.OrderEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ" Height="550" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата заказа:" Margin="5"/>
        <DatePicker Grid.Row="0" Grid.Column="1" Name="dpOrderDate" Margin="5"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Клиент:" Margin="5"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Name="cbClient" DisplayMemberPath="full_name" SelectedValuePath="id" Margin="5"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Курьер:" Margin="5"/>
        <ComboBox Grid.Row="2" Grid.Column="1" Name="cbCourier" DisplayMemberPath="full_name" SelectedValuePath="id" Margin="5"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Адрес доставки:" Margin="5"/>
        <TextBox Grid.Row="3" Grid.Column="1" Name="txtDeliveryAddress" Margin="5"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Статус:" Margin="5"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Name="cbStatus" Margin="5">
            <ComboBoxItem Content="Создан"/>
            <ComboBoxItem Content="В пути"/>
            <ComboBoxItem Content="Доставлен"/>
            <ComboBoxItem Content="Отменён"/>
        </ComboBox>
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Вес (кг):" Margin="5"/>
        <TextBox Grid.Row="5" Grid.Column="1" Name="txtWeight" Margin="5"/>
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Сохранить" Width="80" Click="btnSave_Click" Margin="5"/>
            <Button Content="Отмена" Width="80" Click="btnCancel_Click" Margin="5"/>
        </StackPanel>
        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Name="txtError" Foreground="Red" Margin="5"/>
    </Grid>
</Window>